rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 여부: admins/{uid} 문서가 있으면 관리자. 이 문서는 Firebase 콘솔에서만 만들 수 있다.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 본인이 관리자인지 확인하는 것만 허용 (만들기·수정·삭제는 콘솔에서만)
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // 로그인한 본인만 자기 데이터(users/{uid} 와 그 아래 메모·회의록·일정)를 읽고 쓸 수 있다.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 홈페이지(malbiseo.kr/support) 문의·오류 신고.
    // 누구나 정해진 형식으로 "보내기"만 가능하고, 보기·처리·삭제는 관리자(malbiseo.kr/admin)만 할 수 있다.
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['type', 'email', 'title', 'body', 'device', 'status', 'userAgent', 'createdAt'])
                    && request.resource.data.keys().hasAll(['type', 'email', 'title', 'body', 'status', 'createdAt'])
                    && request.resource.data.type in ['question', 'bug', 'feature', 'account']
                    && request.resource.data.status == 'new'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.body is string
                    && request.resource.data.body.size() >= 5
                    && request.resource.data.body.size() <= 3000
                    && (!('device' in request.resource.data) || (request.resource.data.device is string && request.resource.data.device.size() <= 100))
                    && (!('userAgent' in request.resource.data) || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300))
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.createdAt > request.time - duration.value(1, 'h')
                    && request.resource.data.createdAt < request.time + duration.value(1, 'h');
      // 관리자만 보기·삭제, 수정은 처리 상태(status)만 바꿀 수 있다
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['new', 'done'];
    }
  }
}
